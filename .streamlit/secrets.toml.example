[sqlserver]
# 仅填写部署环境实际信息；不要将 secrets.toml 提交到 Git。
server = "your-sql-server.example.com,1433"
database = "your_database"
username = "readonly_report_user"
password = "replace-with-a-secret"
driver = "ODBC Driver 18 for SQL Server"
encrypt = true
trust_server_certificate = false
connection_timeout_seconds = 15
query_timeout_seconds = 60
# 必填：填写 SQL Server 返回的 SYSTEM_USER / ORIGINAL_LOGIN() 的精确值。
# 只有名单中的专用只读账号可被本应用接受；不要填管理员或共享账号。
allowed_logins = ["report_export_reader"]

[app]
# demo：无需 SQL Server，使用本地模拟订单完成界面和 Excel 验证。
# sqlserver：读取以上 sqlserver 配置并连接真实只读数据库。
mode = "sqlserver"
max_date_range_days = 31
max_export_rows = 1048576
audit_db_path = "audit.db"
